# Copy to .env (git-ignored) and fill in. docker compose reads it for docker-compose.yml.
# Placeholders only: never commit real values.

# ---- Image --------------------------------------------------------------------------------------------------------------
# Leave unset to build from source; or run a published image, e.g. ghcr.io/umaisnisar/finsight:latest
# FINSIGHT_IMAGE=ghcr.io/umaisnisar/finsight:latest
FINSIGHT_PORT=8080

# ---- Database (required) ------------------------------------------------------------------------------------------------
# Used by both the postgres container and the app's connection string. Avoid ; and quotes: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# ---- Data Protection key ring (required outside Development) -----------------------------------------------------------
# The key ring encrypts transaction descriptions, Gmail refresh tokens and Gemini keys. Production: mount a PKCS#12
# certificate (see the volume comment in docker-compose.yml) and set its path and password. Without a certificate the app
# refuses to start on Linux unless DATAPROTECTION_ALLOW_UNPROTECTED_KEYS=true, which is for local testing only.
DATAPROTECTION_CERTIFICATE_PATH=
DATAPROTECTION_CERTIFICATE_PASSWORD=
DATAPROTECTION_ALLOW_UNPROTECTED_KEYS=true

# ---- Public address -----------------------------------------------------------------------------------------------------
# Where users open FinSight (used for links in email), and the host names the app answers to (semicolon-separated).
APP_PUBLIC_URL=http://localhost:8080
ALLOWED_HOSTS=localhost;127.0.0.1
# true only behind a reverse proxy that terminates TLS and sets X-Forwarded-For and X-Forwarded-Proto.
FORWARDED_HEADERS_ENABLED=false

# ---- Demo mode ----------------------------------------------------------------------------------------------------------
# "Explore with sample data" without any credentials. Off by default in Production; turn it on to try FinSight locally.
DEMO_ENABLED=true

# ---- Google sign-in and Gmail (optional) --------------------------------------------------------------------------------
# Register <APP_PUBLIC_URL>/api/auth/google/callback as an authorized redirect URI for this client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Gemini (optional) --------------------------------------------------------------------------------------------------
# Server-wide key; users can also add their own in Settings.
GEMINI_API_KEY=

# ---- Email for monthly summaries (optional) -----------------------------------------------------------------------------
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
