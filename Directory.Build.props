<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage source generators are not worth the noise at this scale.
         CA1707: xUnit test names use underscores. CA2007: no SynchronizationContext in ASP.NET Core. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1707;CA2007;CA1305;CA1304;CA1311;CA1862;CA1716;CA1515;CA1031;CA1002;CA2227;CA1819;CA1056;CA1054;CA1055;CA5394;CA1822;CA1307;CA1309;CA1310</NoWarn>
  </PropertyGroup>

</Project>
